pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Validate Project Files') {
            steps {
                dir('triggerflow') {
                    bat '''
                        if not exist index.html exit /b 1
                        if not exist style.css exit /b 1
                        if not exist Dockerfile exit /b 1
                        echo Required project files are present and verified.
                    '''
                }
            }
        }
        stage('Pipeline Integration Check') {
            steps {
                echo "TriggerFlow CI/CD Pipeline workflow executed successfully!"
            }
        }
    }
}
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Validate Project Files') {
            steps {
                dir('triggerflow') {
                    powershell '''
                        if (!(Test-Path "index.html")) { throw "index.html not found" }
                        if (!(Test-Path "style.css")) { throw "style.css not found" }
                        if (!(Test-Path "Dockerfile")) { throw "Dockerfile not found" }
                        Write-Host "Required project files are present."
                    '''
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('triggerflow') {
                    powershell '& "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" build -t triggerflow-web:$env:BUILD_NUMBER .'
                }
            }
        }
        stage('Deploy Container') {
            steps {
                powershell '''
                    & "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" stop triggerflow-app -ErrorAction SilentlyContinue
                    & "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" rm triggerflow-app -ErrorAction SilentlyContinue
                    & "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" run -d -p 8081:80 --name triggerflow-app triggerflow-web:$env:BUILD_NUMBER
                '''
            }
        }
        stage('Smoke Test') {
            steps {
                powershell '''
                    foreach ($i in 1..5) {
                        try {
                            $response = Invoke-WebRequest -Uri "http://localhost:8081" -UseBasicParsing
                            if ($response.StatusCode -eq 200) {
                                Write-Host "App is responding successfully!"
                                exit 0
                            }
                        } catch {
                            Write-Host "Attempt $i: Waiting for app..."
                            Start-Sleep -Seconds 3
                        }
                    }
                    throw "Smoke test failed: App did not respond."
                '''
            }
        }
    }
}
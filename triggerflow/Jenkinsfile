pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Validate Project Files') {
            steps {
                dir('triggerflow') {
                    bat '''
                        if not exist index.html exit /b 1
                        if not exist style.css exit /b 1
                        if not exist Dockerfile exit /b 1
                        echo Required project files are present.
                    '''
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                dir('triggerflow') {
                    bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" build -t triggerflow-web:%BUILD_NUMBER% .'
                }
            }
        }
        stage('Deploy Container') {
            steps {
                bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" stop triggerflow-app || true'
                bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" rm triggerflow-app || true'
                bat '"C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe" run -d -p 8081:80 --name triggerflow-app triggerflow-web:%BUILD_NUMBER%'
            }
        }
        stage('Smoke Test') {
            steps {
                bat '''
                    powershell -Command "foreach ($i in 1..5) { try { $res = Invoke-WebRequest -Uri 'http://localhost:8081' -UseBasicParsing; if ($res.StatusCode -eq 200) { exit 0 } } catch { Start-Sleep -Seconds 3 } } exit 1"
                '''
            }
        }
    }
}